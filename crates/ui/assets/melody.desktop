[Desktop Entry]
Name=Melody
Comment=Fast and lightweight pure-Rust native music player
Exec=melody %F
Icon=melody
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Player;Music;
Keywords=music;sound;audio;player;playback;
MimeType=audio/mpeg;audio/flac;audio/ogg;audio/wav;audio/x-matroska;audio/aac;audio/m4a;
StartupWMClass=melody
