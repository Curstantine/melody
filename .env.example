# Compile-time credentials baked into `extensions/lastfm/extension.wasm` by
# `scripts/build-extensions.ps1` / `scripts/build-extensions.sh`.
#
# Why: Last.fm requires every signed API call (`auth.getSession`, `track.scrobble`,
# `track.updateNowPlaying`) to include an `api_key` and `api_sig` computed with the
# application's shared secret. Baking these in at build time lets users sign in via
# the one-click "Connect Last.fm" browser flow without registering their own Last.fm
# API application, while keeping the app credentials out of source control.
#
# Copy this file to `.env` and fill in your Last.fm API credentials from
# https://www.last.fm/api/account/create (leave Callback URL blank).
MELODY_LASTFM_API_KEY=
MELODY_LASTFM_API_SECRET=

# Compile-time Discord Application ID baked into `extensions/discord-rpc/extension.wasm` by
# `scripts/build-extensions.ps1` / `scripts/build-extensions.sh`.
#
# Obtain an Application ID from https://discord.com/developers/applications (General Information).
MELODY_DISCORD_CLIENT_ID=
